rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teamMember(teamId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/access/$(request.auth.uid));
    }

    // Created by the Firebase project administrator, never by a browser client.
    match /teamInvites/{teamId} {
      allow read, write: if false;
    }

    match /teams/{teamId} {
      allow get: if teamMember(teamId);
      allow list, create, update, delete: if false;

      match /access/{userId} {
        allow create: if signedIn() && request.auth.uid == userId &&
          exists(/databases/$(database)/documents/teams/$(teamId)) &&
          exists(/databases/$(database)/documents/teamInvites/$(teamId)) &&
          request.resource.data.keys().hasOnly(['code', 'joinedAt']) &&
          request.resource.data.keys().hasAll(['code', 'joinedAt']) &&
          request.resource.data.code is string &&
          request.resource.data.code ==
            get(/databases/$(database)/documents/teamInvites/$(teamId)).data.code;
        allow get, list, update, delete: if false;
      }

      match /roster/{slotId} {
        allow read, write: if teamMember(teamId);
      }

      match /presence/{userId} {
        allow read: if teamMember(teamId);
        allow create, update, delete: if teamMember(teamId) && request.auth.uid == userId;
      }

      match /weeks/{weekId} {
        allow read, write: if teamMember(teamId);

        match /logs/{logId} {
          allow read, write: if teamMember(teamId);
        }
        match /members/{slotId} {
          allow read, write: if teamMember(teamId);

          match /photos/{photoId} {
            allow read, write: if teamMember(teamId);
          }
        }
      }
    }
  }
}
