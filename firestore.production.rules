rules_version = '2';
// Production hyundai-8966e rules. Legacy access preserved; new documents require invitation.
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/team-3 {
      allow read, write: if request.auth != null;
      match /{legacyCollection}/{path=**} {
        allow read, write: if request.auth != null
          && !(legacyCollection in ['documents','collaborationMembers','collaborationInvites']);
      }
    }
    function member(team) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(team)/collaborationMembers/$(request.auth.uid));
    }
    function editor(team) {
      return member(team) && get(/databases/$(database)/documents/teams/$(team)/collaborationMembers/$(request.auth.uid)).data.role == 'editor';
    }
    match /teams/{team}/collaborationMembers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','inviteHash','joinedAt'])
        && request.resource.data.role == 'editor'
        && request.resource.data.joinedAt == request.time
        && request.resource.data.inviteHash is string
        && request.resource.data.inviteHash.matches('^[a-f0-9]{64}$')
        && get(/databases/$(database)/documents/teams/$(team)/collaborationInvites/$(request.resource.data.inviteHash)).data.enabled == true;
      allow list, update, delete: if false; // only admin can change a membership
    }
    match /teams/{team}/collaborationInvites/{inviteId} {
      allow read, write: if false;
    }
    match /teams/{team}/documents/{documentId} {
      allow read: if member(team);
      allow create: if editor(team)
        && request.resource.data.keys().hasOnly(['title','week','schema','createdBy','createdAt','seedId'])
        && request.resource.data.schema == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.week is string && request.resource.data.week.size() <= 20
        && request.resource.data.seedId is string && request.resource.data.seedId.matches('^[a-f0-9]{64}$');
      // Only the checkpoint pointer may change: it moves strictly forward, to an existing checkpoint whose declared
      // coverage equals the new cutoff, and never into the future. History itself is never modified or deleted.
      // Title and "deleted" (hidden from the list) may be changed by any editor; the content is never deleted here.
      allow update: if editor(team)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','archived','archivedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 150
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt == request.time);
      allow update: if editor(team)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkpointId','checkpointCutoff'])
        && request.resource.data.checkpointId is string && request.resource.data.checkpointId.matches('^[a-f0-9]{64}$')
        && request.resource.data.checkpointCutoff is timestamp
        && request.resource.data.checkpointCutoff < request.time
        && (!('checkpointCutoff' in resource.data) || request.resource.data.checkpointCutoff > resource.data.checkpointCutoff)
        && get(/databases/$(database)/documents/teams/$(team)/documents/$(documentId)/checkpoints/$(request.resource.data.checkpointId)).data.coveredUntil == request.resource.data.checkpointCutoff;
      allow delete: if false;
      match /updates/{updateId} {
        allow read: if member(team);
        allow create: if editor(team)
          && existsAfter(/databases/$(database)/documents/teams/$(team)/documents/$(documentId))
          && request.resource.data.keys().hasOnly(['schema','hash','author','session','codec','rawSize','chunks','createdAt','data'])
          && request.resource.data.schema == 1 && request.resource.data.codec == 'deflate'
          && request.resource.data.author == request.auth.uid
          && request.resource.data.session is string && request.resource.data.session.size() <= 100
          && updateId.matches('^[a-f0-9]{64}$') && request.resource.data.hash == updateId
          && request.resource.data.rawSize is int && request.resource.data.rawSize >= 2 && request.resource.data.rawSize <= 100663296
          && request.resource.data.chunks is int
          // chunks == 0: small update stored inline in this document (1 write, 1 read per reader).
          // chunks 1..32: large update split into chunks/{n}; such a record must not also carry inline data.
          && ((request.resource.data.chunks == 0
                && request.resource.data.data is bytes
                && request.resource.data.data.size() >= 1 && request.resource.data.data.size() <= 262144)
              || (request.resource.data.chunks >= 1 && request.resource.data.chunks <= 32
                && !('data' in request.resource.data)))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
        match /chunks/{chunkId} {
          function envelope() {
            return getAfter(/databases/$(database)/documents/teams/$(team)/documents/$(documentId)/updates/$(updateId)).data;
          }
          allow read: if member(team);
          allow create: if editor(team)
            && envelope().author == request.auth.uid && envelope().createdAt == request.time
            && chunkId.matches('^([0-9]|[12][0-9]|3[01])$')
            && int(chunkId) < envelope().chunks
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is bytes && request.resource.data.data.size() <= 131072;
          allow update, delete: if false;
        }
      }
      match /presence/{session} {
        allow read: if member(team);
        allow create, update: if editor(team)
          && request.resource.data.keys().hasOnly(['uid','name','anchor','active','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && (resource == null || resource.data.uid == request.auth.uid)
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.anchor is string && request.resource.data.anchor.size() <= 4096
          && request.resource.data.active is bool && request.resource.data.updatedAt == request.time;
        allow delete: if editor(team) && resource.data.uid == request.auth.uid;
      }
      // Compacted copies made by teammates' browsers (Spark has no Cloud Functions). Immutable once written.
      match /checkpoints/{checkpointId} {
        allow read: if member(team);
        allow create: if editor(team)
          && checkpointId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['schema','hash','codec','rawSize','chunks','createdAt','createdBy','coveredUntil'])
          && request.resource.data.schema == 1 && request.resource.data.codec == 'deflate'
          && request.resource.data.hash == checkpointId
          && request.resource.data.rawSize is int && request.resource.data.rawSize >= 2 && request.resource.data.rawSize <= 100663296
          && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 32
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.coveredUntil is timestamp && request.resource.data.coveredUntil < request.time;
        allow update, delete: if false;
        match /chunks/{chunkId} {
          function checkpoint() {
            return getAfter(/databases/$(database)/documents/teams/$(team)/documents/$(documentId)/checkpoints/$(checkpointId)).data;
          }
          allow read: if member(team);
          allow create: if editor(team)
            && checkpoint().createdBy == request.auth.uid && checkpoint().createdAt == request.time
            && chunkId.matches('^([0-9]|[12][0-9]|3[01])$')
            && int(chunkId) < checkpoint().chunks
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is bytes && request.resource.data.data.size() <= 131072;
          allow update, delete: if false;
        }
      }
    }
  }
}
