// Publish only to Firebase project jongwon-log-team-2.
// The existing jangwon-287b2 project and its rules stay unchanged.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/team-2/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
